{"uid":"src/flex_layout.c::fx_grid_column_count","name":"fx_grid_column_count","qualname":"fx_grid_column_count","kind":"function","file":"src/flex_layout.c","line":133,"end_line":139,"language":"c","signature":"int fx_grid_column_count(int flow, int cols, int rows, size_t items)","params":[{"name":"flow","annotation":"int","default":"","kind":"positional"},{"name":"cols","annotation":"int","default":"","kind":"positional"},{"name":"rows","annotation":"int","default":"","kind":"positional"},{"name":"items","annotation":"size_t","default":"","kind":"positional"}],"returns":"int","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Column count of a grid container (CSS Grid 1 8.5).","description":"With `grid-auto-flow: column` (flow == 2, css_grid_flow) and no explicit rows, items fill a single row and each one opens an implicit column, so the count is max(declared, items); every other case keeps `cols`. Never below 1, never above FX_GRID_COLS_MAX: `items` comes from the confined worker. Pure.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[["Inherited","Documentation from `fx_grid_column_count` (include/flex_layout.h:139)."]],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"src/flex_layout.c","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"src/flex_layout.c::fx_autofill_count","name":"fx_autofill_count","qualname":"fx_autofill_count","kind":"function","file":"src/flex_layout.c","line":141,"end_line":149,"language":"c","signature":"size_t fx_autofill_count(double avail, double gap, double minw)","params":[{"name":"avail","annotation":"double","default":"","kind":"positional"},{"name":"gap","annotation":"double","default":"","kind":"positional"},{"name":"minw","annotation":"double","default":"","kind":"positional"}],"returns":"size_t","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"repeat(auto-fill, minmax(min, max)): how many min-wide tracks fit in avail (CSS Grid 1 7.2.3.2; one gap between tracks).","description":"Pure: floor((avail+gap)/(min+gap)) clamped to [1, FX_MAX_ITEMS]. Non-positive/NaN inputs fail safe to 1 (never 0: a grid with zero columns places nothing). The caller still caps to its own BT_MAX_CHILDREN. See spec/css.md (2026-10-09).","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[["Inherited","Documentation from `fx_autofill_count` (include/flex_layout.h:129)."]],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"src/flex_layout.c","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}

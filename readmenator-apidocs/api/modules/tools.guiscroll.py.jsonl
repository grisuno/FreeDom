{"uid":"tools/guiscroll.py","name":"guiscroll.py","qualname":"tools/guiscroll.py","kind":"module","file":"tools/guiscroll.py","line":1,"end_line":141,"language":"py","signature":"","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"guiscroll -- what one frame costs in the REAL Freedom window while the user scrolls.","description":"guitime measures \"navigate -> painted and idle\"; this measures the frames AFTER that: the\npage is loaded in a nested weston (Xvfb + weston, pixman renderer, same harness as guitime),\nthen xdotool turns the mouse wheel over the content N times, one notch every WHEEL_GAP_S.\nThe window runs with FREEDOM_JS_PROFILE=1, so every frame prints its phases on stderr\n(\"gui-profile paint(total) ...\" and the layout_doc / position_doc lines). Only the frames\npainted after the first wheel notch are counted.\n\nUsage: guiscroll.py [--bin PATH] [--notches N] <page.html> ...\nPrints one line per page:  <name>       <frames>        <median frame ms>       <p90 frame ms>  <median layout ms>\nExit 0 when every page was measured, 1 on a failed measurement, 2 when the environment is missing.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"","members":["tools/guiscroll.py::LOAD_WAIT_S","tools/guiscroll.py::WHEEL_GAP_S","tools/guiscroll.py::SETTLE_S","tools/guiscroll.py::MARK","tools/guiscroll.py::phase_ms","tools/guiscroll.py::one_page","tools/guiscroll.py::main","tools/guiscroll.py::procs_display"],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}

{"uid":"src/pdf_export.c::pe_paginate","name":"pe_paginate","qualname":"pe_paginate","kind":"function","file":"src/pdf_export.c","line":95,"end_line":115,"language":"c","signature":"size_t pe_paginate(const double *tops, const double *heights, size_t n, double page_h, int *out_page, double *out_page_y)","params":[{"name":"tops","annotation":"double *","default":"","kind":"positional"},{"name":"heights","annotation":"double *","default":"","kind":"positional"},{"name":"n","annotation":"size_t","default":"","kind":"positional"},{"name":"page_h","annotation":"double","default":"","kind":"positional"},{"name":"out_page","annotation":"int *","default":"","kind":"positional"},{"name":"out_page_y","annotation":"double *","default":"","kind":"positional"}],"returns":"size_t","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Deterministic pagination: lays the rows (document-space tops + heights, in order) onto pages of usable height page_h without ever splitting a row.","description":"Writes out_page[i] (0-based page index) and out_page_y[i] (y within that page) for each of the n rows. Returns the page count (last page + 1), or 0 if n == 0, page_h <= 0, or any pointer is NULL. A row taller than page_h gets its own page starting at y == 0 and overflows (it is not split). Vertical gaps between rows are preserved within a page.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[["Inherited","Documentation from `pe_paginate` (include/pdf_export.h:70)."]],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"src/pdf_export.c","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}

{"uid":"include/js_sandbox.h::js_pump_jobs","name":"js_pump_jobs","qualname":"js_pump_jobs","kind":"function","file":"include/js_sandbox.h","line":159,"end_line":159,"language":"h","signature":"int js_pump_jobs(js_context *ctx, int max_jobs);","params":[{"name":"ctx","annotation":"js_context *","default":"","kind":"positional"},{"name":"max_jobs","annotation":"int","default":"","kind":"positional"}],"returns":"int","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Runs up to max_jobs pending microtasks/jobs (promise reactions queued by the last eval), under the context's current time budget.","description":"Job exceptions (rejected promises with no handler, etc.) are swallowed -- a job never aborts the caller. Returns the number of jobs run. Needed because js_eval does not drain the queue itself, so promise/.then/await continuations (e.g. from fetch) would otherwise never run. No-op (returns 0) on a NULL context.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"include/js_sandbox.h","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}

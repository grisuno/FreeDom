{"uid":"include/js_sandbox.h::js_set_current_script","name":"js_set_current_script","qualname":"js_set_current_script","kind":"function","file":"include/js_sandbox.h","line":171,"end_line":171,"language":"h","signature":"void js_set_current_script(js_context *ctx, const char *src, const char *type);","params":[{"name":"ctx","annotation":"js_context *","default":"","kind":"positional"},{"name":"src","annotation":"char *","default":"","kind":"positional"},{"name":"type","annotation":"char *","default":"","kind":"positional"}],"returns":"void","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Sets document.currentScript on the global object so external scripts can read their own src / type / data-* attributes through getAttribute.","description":"The script element is a fabricated plain object with {src, type, getAttribute} that answers these three keys. Pass src=NULL for an inline script (no src attribute). Call after the evaluation to restore currentScript to null.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"include/js_sandbox.h","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}

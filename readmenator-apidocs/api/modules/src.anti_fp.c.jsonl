{"uid":"src/anti_fp.c::fp_bucket_screen","name":"fp_bucket_screen","qualname":"fp_bucket_screen","kind":"function","file":"src/anti_fp.c","line":99,"end_line":117,"language":"c","signature":"void fp_bucket_screen(int w, int h, int *out_w, int *out_h)","params":[{"name":"w","annotation":"int","default":"","kind":"positional"},{"name":"h","annotation":"int","default":"","kind":"positional"},{"name":"out_w","annotation":"int *","default":"","kind":"positional"},{"name":"out_h","annotation":"int *","default":"","kind":"positional"}],"returns":"void","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Snaps a screen size to a standard bucket (cuts entropy). out_w/out_h non-NULL.","description":"Picks the largest-area bucket that fits in (w,h); if none fits, the smallest.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[["Inherited","Documentation from `fp_bucket_screen` (include/anti_fp.h:83)."]],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"src/anti_fp.c","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"src/anti_fp.c::fp_perturb","name":"fp_perturb","qualname":"fp_perturb","kind":"function","file":"src/anti_fp.c","line":128,"end_line":137,"language":"c","signature":"void fp_perturb(uint8_t *buf, size_t len, uint64_t session_key)","params":[{"name":"buf","annotation":"uint8_t *","default":"","kind":"positional"},{"name":"len","annotation":"size_t","default":"","kind":"positional"},{"name":"session_key","annotation":"uint64_t","default":"","kind":"positional"}],"returns":"void","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Deterministic per-session readback poisoning (canvas/audio): flips only the least-significant bit of a sparse, key-selected subset of bytes.","description":"Same (buf,key) => same output; different key => different output. NULL/len 0 = no-op.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[["Inherited","Documentation from `fp_perturb` (include/anti_fp.h:88)."]],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"src/anti_fp.c","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"src/anti_fp.c::fp_origin_key","name":"fp_origin_key","qualname":"fp_origin_key","kind":"function","file":"src/anti_fp.c","line":139,"end_line":156,"language":"c","signature":"uint64_t fp_origin_key(uint64_t session_key, const char *registrable_domain)","params":[{"name":"session_key","annotation":"uint64_t","default":"","kind":"positional"},{"name":"registrable_domain","annotation":"char *","default":"","kind":"positional"}],"returns":"uint64_t","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Derives the per-origin readback key from the per-session secret and a site's registrable domain (eTLD+1).","description":"Same (session_key, domain) => same key (poisoning is stable within a site); different domains under the same session => different keys with overwhelming probability (canvas/audio noise is not linkable across sites, defeating cross-origin fingerprint linking). registrable_domain NULL or \"\" collapses to a single namespace (its own stable key, distinct from any real domain); never aborts, never leaks. Pure: no I/O, no allocation. The caller (tab worker) computes the eTLD+1 via request_policy and passes it here.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[["Inherited","Documentation from `fp_origin_key` (include/anti_fp.h:98)."]],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"src/anti_fp.c","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}

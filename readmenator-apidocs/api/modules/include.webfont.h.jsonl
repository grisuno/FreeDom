{"uid":"include/webfont.h::wf_name_hash","name":"wf_name_hash","qualname":"wf_name_hash","kind":"function","file":"include/webfont.h","line":69,"end_line":79,"language":"h","signature":"static inline unsigned wf_name_hash(const char *s, size_t n)","params":[{"name":"s","annotation":"char *","default":"","kind":"positional"},{"name":"n","annotation":"size_t","default":"","kind":"positional"}],"returns":"unsigned","decorators":[],"bases":[],"modifiers":["inline","static"],"visibility":"public","doc":{"summary":"FNV-1a (32-bit) over s[0,n), lowercased per byte, for author family names.","description":"The worker hashes the cascaded first-name, the parent hashes scanned @font-face families; equal names hash equal on both sides regardless of the author's capitalisation. Empty/NULL hashes to 0 (=\"no webfont\"); a nonempty name that hashes to 0 is remapped to 1 so 0 keeps its single meaning. Pure, no allocation. Static inline (like the csel_* ASCII helpers) so the cascade side needs no new link edge: every css.o consumer already links.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"include/webfont.h","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":["src/text_shape.c::tsh_webfont_register","src/webfont_load.c::WF_DATA_URL_MAX"]}

{"uid":"include/request_policy.h::rp_sanitize_request_headers","name":"rp_sanitize_request_headers","qualname":"rp_sanitize_request_headers","kind":"function","file":"include/request_policy.h","line":57,"end_line":57,"language":"h","signature":"int rp_sanitize_request_headers(const char *raw, char *out, size_t cap);","params":[{"name":"raw","annotation":"char *","default":"","kind":"positional"},{"name":"out","annotation":"char *","default":"","kind":"positional"},{"name":"cap","annotation":"size_t","default":"","kind":"positional"}],"returns":"int","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Filters the page-supplied header block `raw` (\"Name: value\" lines separated by '\\n') into `out` (same format, '\\n'-terminated lines, NUL-terminated) keeping ONLY headers a page may set: well-formed token name and a value free of control bytes, within the count/size caps, and not on the forbidden list (identity and framing headers the browser owns: Host, Cookie, Referer, User-Agent, Accept-Language, Accept-Encoding, Connection, Content-Length, Transfer-Encoding, TE, Upgrade, Expect, Date, DNT, Via, Origin, Sec-*, Proxy-*, X-HTTP-Method*, Access-Control-Request-*).","description":"A repeated name keeps its first occurrence. Pure; fail-closed (anything doubtful is dropped, never rewritten). Returns the number of headers kept, or -1 on NULL/zero-capacity arguments.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"include/request_policy.h","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}

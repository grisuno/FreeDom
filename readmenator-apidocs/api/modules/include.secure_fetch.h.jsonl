{"uid":"include/secure_fetch.h::SF_DEFAULT_KEX_GROUPS","name":"SF_DEFAULT_KEX_GROUPS","qualname":"SF_DEFAULT_KEX_GROUPS","kind":"macro","file":"include/secure_fetch.h","line":166,"end_line":166,"language":"h","signature":"#define SF_DEFAULT_KEX_GROUPS","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"PQ-hybrid is preferred (listed first); classical groups are also offered so a non-PQ host completes the TLS 1.3 handshake and yields a clean SF_ERR_KEM_NOT_PQ under the strict policy (instead of an opaque handshake failure) — which lets the orchestrator offer the classical-KE navigability fallback.","description":"Offering a classical group never weakens the strict policy: a classical *negotiated* group is still rejected by sf_check_group_is_pq.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"include/secure_fetch.h","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"include/secure_fetch.h::SF_IMPERSONATE_KEX_GROUPS","name":"SF_IMPERSONATE_KEX_GROUPS","qualname":"SF_IMPERSONATE_KEX_GROUPS","kind":"macro","file":"include/secure_fetch.h","line":175,"end_line":175,"language":"h","signature":"#define SF_IMPERSONATE_KEX_GROUPS","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Interim impersonation ClientHello shaping (OpenSSL, Hito TLS Fase 3).","description":"A classical profile consistent with FP_USER_AGENT (Firefox): it DROPS X25519MLKEM768 (almost no shipping Firefox of our advertised version offers MLKEM, so offering it under that UA is the single loudest TLS tell) and orders the TLS 1.3 ciphersuites Firefox-style (AES-128-GCM, CHACHA20, AES-256-GCM). A Chrome ClientHello under a Firefox UA would be a NEW mismatch, so the interim matches the identity we already send; byte-exact Chrome JA3 is the BoringSSL helper (spec/tls_impersonate.md). Groups mirror Firefox 128's supported_groups order.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"include/secure_fetch.h","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}

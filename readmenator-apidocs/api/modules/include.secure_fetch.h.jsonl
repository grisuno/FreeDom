{"uid":"include/secure_fetch.h::SF_IMPERSONATE_TLS12_CIPHERS","name":"SF_IMPERSONATE_TLS12_CIPHERS","qualname":"SF_IMPERSONATE_TLS12_CIPHERS","kind":"macro","file":"include/secure_fetch.h","line":180,"end_line":180,"language":"h","signature":"#define SF_IMPERSONATE_TLS12_CIPHERS","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Firefox 128 TLS 1.2 ciphersuite list (OpenSSL names, in wire order).","description":"OpenSSL's default advertises ~80 TLS 1.2 suites; Firefox advertises ~14, so restricting the list is the single biggest shrink of the JA3/JA4 cipher field toward the browser.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"include/secure_fetch.h","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}
{"uid":"include/secure_fetch.h::SF_DEFAULT_USER_AGENT","name":"SF_DEFAULT_USER_AGENT","qualname":"SF_DEFAULT_USER_AGENT","kind":"macro","file":"include/secure_fetch.h","line":191,"end_line":191,"language":"h","signature":"#define SF_DEFAULT_USER_AGENT","params":[],"returns":"","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"The default User-Agent IS the anti-fingerprinting identity (FP_USER_AGENT): it must match navigator.userAgent exactly and must not advertise \"Freedom\" (that is a unique fingerprint and a bot signal that breaks sites like Google).","description":"Demoting the old \"Freedom/0.1\" to merely a brand string was deliberate; never reintroduce a product name here. The user can still override per session in the menu.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"include/secure_fetch.h","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":[],"called_by":[]}

{"uid":"src/prefetch.c::pf_pool_take","name":"pf_pool_take","qualname":"pf_pool_take","kind":"function","file":"src/prefetch.c","line":271,"end_line":308,"language":"c","signature":"int pf_pool_take(pf_pool *p, const char *url, int *rc, int *status, char **body, size_t *len, char **ctype)","params":[{"name":"p","annotation":"pf_pool *","default":"","kind":"positional"},{"name":"url","annotation":"char *","default":"","kind":"positional"},{"name":"rc","annotation":"int *","default":"","kind":"positional"},{"name":"status","annotation":"int *","default":"","kind":"positional"},{"name":"body","annotation":"char **","default":"","kind":"positional"},{"name":"len","annotation":"size_t *","default":"","kind":"positional"},{"name":"ctype","annotation":"char **","default":"","kind":"positional"}],"returns":"int","decorators":[],"bases":[],"modifiers":[],"visibility":"public","doc":{"summary":"Cache-first take.","description":"On a hit (url matches an unconsumed job) WAITS for that job and MOVES the result to the caller: *rc is the callback's return value and, when *rc == 0, the caller owns the returned body and ctype. Returns 1 on hit, 0 on miss (unknown or already-consumed URL, pool not started): the caller then fetches directly. A fetch failure is a hit with *rc != 0 -- the caller must NOT retry (same outcome as the serial path, without duplicating requests). Single owner: a second take of the same URL is a miss.","params":[],"returns":null,"yields":null,"raises":[],"attributes":[],"examples":[],"notes":[["Inherited","Documentation from `pf_pool_take` (include/prefetch.h:115)."]],"see_also":[],"deprecated":"","since":"","style":"plain"},"parent":"src/prefetch.c","members":[],"inferred_raises":[],"returns_value":null,"value":"","base_uids":[],"subclasses":[],"calls":["gui/browser_ui.c::strcmp"],"called_by":["src/prefetch.c::pf_pooled_fetch"]}
